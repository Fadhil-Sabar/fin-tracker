# FinTrack — Environment Variables
# Copy this file to .env and fill in the values.

# Google Sheets Spreadsheet ID (from Google Sheets URL)
GOOGLE_SHEETS_SPREADSHEET_ID=1s6AakyIC710yjEmdXnLX3-UHMbJddHsk0eCQmN3dacE

# OPTIONAL: Sheet name (default: "Sample")
# SHEET_NAME=Sample

# ── Auth: pick ONE ──

# 1. Local development: path to Google OAuth token
# GOOGLE_TOKEN_PATH=/opt/data/google_token.json

# 2. Cloudflare deployment: Service Account JSON key (as single-line string)
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@...gserviceaccount.com",...}
